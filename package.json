{
  "name": "cubby",
  "productName": "Cubby",
  "version": "0.1.0",
  "description": "Every brand gets its own cubby — sealed Chrome per brand, composer, approvals, flows, Local API + MCP.",
  "main": "./out/main/index.js",
  "author": { "name": "FF Dev Studio", "email": "hello@ffdev.studio", "url": "https://ffdev.studio" },
  "homepage": "https://github.com/Aphrosidiac/Cubby",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "build": "electron-vite build",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "croner": "^10.0.1",
    "fastify": "5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "otplib": "^13.5.0",
    "playwright-core": "1.64.0",
    "tar-stream": "^3.2.2",
    "zod": "4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2",
    "@types/node": "24",
    "@types/tar-stream": "^3.1.5",
    "@vitejs/plugin-vue": "6",
    "electron": "44.7.0",
    "electron-builder": "26",
    "electron-vite": "5",
    "typescript": "5.9",
    "vite": "7",
    "vitest": "3",
    "vue": "3.5",
    "vue-router": "4",
    "vue-tsc": "3",
    "@fullcalendar/core": "6",
    "@fullcalendar/daygrid": "6",
    "@fullcalendar/interaction": "6",
    "@fullcalendar/list": "6",
    "@fullcalendar/timegrid": "6",
    "@fullcalendar/vue3": "6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "ffmpeg-static",
      "esbuild"
    ]
  }
}
